+//                batch:  at the start of each batch, every key line of the batch KEY_PF_DIST keys ahead
+struct KeyPrefetchConfig {
+  uint64_t dist = 16;
+  int hint = 3;  // __builtin_prefetch locality: 3 = t0, 2 = t1, 1 = t2, 0 = nta
+  bool batch = false;
