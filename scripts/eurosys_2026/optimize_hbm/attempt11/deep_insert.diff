+  if (const char *h = getenv(hint_env)) {
+    std::string hs(h);
+    c.hint = hs == "t1" ? 2 : hs == "t2" ? 1 : hs == "nta" ? 0 : 3;
+  }
+  if (const char *m = getenv("KEY_PF_MODE")) c.batch = std::string(m) == "batch";
+  return c;
