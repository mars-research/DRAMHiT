--- a/include/hashtables/cas_kht.hpp
+++ b/include/hashtables/cas_kht.hpp
@@ -739,6 +739,15 @@
         __asm__("andnl %2, %1, %0" : "=r"(r) : "r"(nbmask), "rm"(x->hash));
         return r;
       };
+      // byte offset of a hash's bucket: andn(~bmask) then << 4 (sizeof(KV)) in one asm, so bmask is never
+      // needed (only nbmask is live) and the 32-bit index is not copied to another register before the shift
+      static_assert(sizeof(KV) == 16, "bucket byte offset = index << 4");
+      const auto hoff = [nbmask](uint32_t h) -> uint64_t {
+        uint64_t r;
+        __asm__("andnl %2, %1, %k0\n\tshlq $4, %0" : "=&r"(r) : "r"(nbmask), "rm"(h));
+        return r;
+      };
+      const char *const htb = reinterpret_cast<const char *>(this->hashtable);  // static member: one register
       // the key broadcast straight from memory (vpbroadcastq m64, one load uop): through
       // _mm512_set1_epi64 gcc loads the key into a GPR first, as the reprobe path reuses it
       const auto bcast_key = [](const FQE *x) -> __m512i {
@@ -804,7 +813,7 @@
 #else
