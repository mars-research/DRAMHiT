 #endif
-            __builtin_prefetch(&ht[nh & bmask], false, 1);  // = prefetch_read, local base
+            __builtin_prefetch(htb + hoff(nh), false, 1);  // = prefetch_read, local base
             fq_put(&FQ(head), e->key, nh, e->key_id);
             head = (head + E) & fq_mask;
